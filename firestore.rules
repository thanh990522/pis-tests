// Public fail-closed reference rules.
// The answer-validating production rules are managed directly in Firebase Console
// so the answer key is never exposed in this public repository.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn()
        && request.auth.token.email == "hachithanh2251999@gmail.com";
    }

    function ownStudentId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId;
    }

    match /users/{uid} {
      allow read: if isTeacher() || (signedIn() && request.auth.uid == uid);
      allow update: if isTeacher()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "fullName", "nickname", "updatedAt", "updatedBy"
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 100
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 50
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;
      allow create, delete: if false;
    }

    match /reports/{reportId} {
      allow read: if isTeacher()
        || (signedIn() && reportId == "unit-1-1-vocab_" + request.auth.uid)
        || (signedIn() && resource.data.uid == request.auth.uid);

      // Unit 1.1 is denied here because its protected grading rule is private.
      allow create: if signedIn()
        && !isTeacher()
        && request.resource.data.testId != "unit-1-1-vocab"
        && request.resource.data.keys().hasOnly([
          "uid", "studentId", "testId", "score", "maxScore",
          "durationSeconds", "submittedAt", "createdAt", "details"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.studentId == ownStudentId()
        && request.resource.data.testId is string
        && request.resource.data.testId.size() > 0
        && request.resource.data.score is number
        && request.resource.data.maxScore is number
        && request.resource.data.score >= 0
        && request.resource.data.maxScore > 0
        && request.resource.data.score <= request.resource.data.maxScore
        && request.resource.data.durationSeconds is number
        && request.resource.data.durationSeconds >= 0
        && request.resource.data.submittedAt is string
        && request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if isTeacher();
    }

    match /testSessions/{sessionId} {
      allow read: if isTeacher()
        || (signedIn() && sessionId == "unit-1-1-vocab_" + request.auth.uid)
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && !isTeacher()
        && sessionId == request.resource.data.testId + "_" + request.auth.uid
        && request.resource.data.keys().hasOnly([
          "uid", "studentId", "testId", "status", "startedAt", "deadlineAt",
          "durationLimitSeconds", "answers", "exitCount", "lastExitReason", "updatedAt"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.studentId == ownStudentId()
        && request.resource.data.testId is string
        && request.resource.data.status == "in_progress"
        && request.resource.data.startedAt is string
        && request.resource.data.deadlineAt is string
        && request.resource.data.durationLimitSeconds == 600
        && request.resource.data.answers is list
        && request.resource.data.exitCount == 0
        && request.resource.data.lastExitReason == ""
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && !isTeacher()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.testId == resource.data.testId
        && request.resource.data.startedAt == resource.data.startedAt
        && request.resource.data.deadlineAt == resource.data.deadlineAt
        && request.resource.data.durationLimitSeconds == 600
        && request.resource.data.answers is list
        && request.resource.data.exitCount is int
        && request.resource.data.exitCount >= resource.data.exitCount
        && request.resource.data.lastExitReason is string
        && request.resource.data.status in ["in_progress", "submitted"]
        && (resource.data.status == "in_progress" || request.resource.data.status == "submitted")
        && request.resource.data.updatedAt == request.time;
      allow delete: if isTeacher();
    }

    match /testReleases/{testId} {
      allow read: if signedIn();
      allow create, update: if isTeacher();
      allow delete: if false;
    }

    // Production rules allow a student to read the unlock key only after both
    // teacher release and that student's own submission. This public copy denies it.
    match /testUnlocks/{testId} {
      allow read: if isTeacher();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
